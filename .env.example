# Copie para .env e preencha com sua connection string do Neon
# Obtenha em: https://console.neon.tech ou via MCP Neon (get_connection_string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Better Auth: URL base da API (callbacks e redirects)
BETTER_AUTH_BASE_URL=http://localhost:8081

# Google OAuth: crie em https://console.cloud.google.com/apis/credentials
# URIs de redirecionamento autorizados: http://localhost:8081/api/auth/callback/google
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-client-secret"

# OpenAI (chat/IA no onboarding) - https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Opcional: rede com proxy/certificado autoassinado (ex.: corporativo). Use só em dev.
# NODE_TLS_REJECT_UNAUTHORIZED=0
